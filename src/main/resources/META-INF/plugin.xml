<idea-plugin>
  <id>com.github.copilot.onedarkpro</id>
  <name>One Dark Pro Pycharm Port</name>
  <vendor>Fino</vendor>
  <description><![CDATA[
    A close PyCharm port of Binaryify's VS Code One Dark Pro theme with matching UI chrome and editor colors tuned for daily use.
  ]]></description>
  <version>1.1.0</version>
  <idea-version since-build="241" />
  <depends>com.intellij.modules.platform</depends>
  <category>UI</category>

  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="one-dark-pro" path="/theme/one-dark-pro.theme.json" />

    <bundledColorScheme path="/theme/one-dark-pro.xml" />
  </extensions>
</idea-plugin>
